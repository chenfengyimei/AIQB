# AIQB 可选运行参数。生产环境推荐通过 PM2/systemd 注入，不要把真实密钥提交到 Git。
AIQB_PORT=3001
AIQB_COLLECTOR_PORT=3002
AIQB_DATA_DIR=./server/data

# community: 仅预置 AI圈报 RSS（推荐开源安装）
# empty: 不预置任何接口
# full: 兼容现有生产站，启用完整分区、热点、日报、同步和公开外部源
AIQB_ENDPOINT_PRESET=community

# full 预设的数据服务根地址；community/empty 不使用。请填写你有权使用的 HTTPS API 根地址。
AIQB_UPSTREAM_BASE_URL=

# 可选：内部性能压测请求排除令牌。请使用随机值，并只保存在服务器环境变量中。
AIQB_BENCHMARK_TOKEN=

# 在线更新源（仓库公开时无需令牌；私有仓库请配置仅具 Contents 读取权限的令牌）。
# 令牌只保存在服务器环境变量，不会通过后台接口返回，也不要提交到 Git。
AIQB_UPDATE_BRANCH=master
AIQB_UPDATE_GITHUB_REPO=chenfengyimei/AIQB
AIQB_UPDATE_GITHUB_TOKEN=
AIQB_UPDATE_GITEE_REPO=chenfengloveyuri/aiqb
AIQB_UPDATE_GITEE_TOKEN=
