# AIQB 可选运行参数。生产环境推荐通过 PM2/systemd 注入，不要把真实密钥提交到 Git。
AIQB_PORT=3000
AIQB_COLLECTOR_PORT=3001
# 运行数据目录。自定义目录必须位于应用目录之外；默认 server/data 会被在线更新专门保留。
AIQB_DATA_DIR=./server/data
AIQB_HOST=127.0.0.1
# 多实例部署时的角色：primary（默认，采集+Web）/ web（只服务流量）/ collector（只采集）。
AIQB_ROLE=primary
# 设 1 时本实例不执行定时采集（等价于 AIQB_ROLE=web 的采集禁用）。
AIQB_DISABLE_COLLECT=

# 首次启动初始化管理员密码（>=12 位；仅在没有管理员账号时生效，设置后请从环境中移除）。
AIQB_INITIAL_ADMIN_PASSWORD=

# 内置每日定时备份：本地触发时刻（HH:MM）、保留份数（1–365）、设 1 时额外复制完整数据目录。
AIQB_BACKUP_AT=04:30
AIQB_BACKUP_KEEP=14
AIQB_BACKUP_FULL=

# 仅填写直接连接 Node 的可信反向代理地址/CIDR；默认只信任本机 Nginx。
AIQB_TRUSTED_PROXIES=127.0.0.1,::1

# 允许通过非 HTTPS 源站访问（仅临时排障用；公网部署务必保持关闭）。
AIQB_ALLOW_HTTP_ORIGIN=

# 百度公开文档当前仍为明文 HTTP。自动提交默认关闭；仅在官方提供证书有效的 HTTPS 地址后配置。
BAIDU_API_URL=
BAIDU_PUSH_TOKEN=

# community: 仅预置 AI圈报 RSS（推荐开源安装）
# empty: 不预置任何接口
# full: 兼容现有生产站，启用完整分区、热点、日报、同步和公开外部源
AIQB_ENDPOINT_PRESET=community

# full 预设的数据服务根地址；community/empty 不使用。请填写你有权使用的 HTTPS API 根地址。
AIQB_UPSTREAM_BASE_URL=

# 可选：内部性能压测请求排除令牌。请使用随机值，并只保存在服务器环境变量中。
AIQB_BENCHMARK_TOKEN=

# 在线更新源（仓库公开时无需令牌；私有仓库请配置仅具 Contents 读取权限的令牌）。
# 令牌只保存在服务器环境变量，不会通过后台接口返回，也不要提交到 Git。
AIQB_UPDATE_BRANCH=master
AIQB_UPDATE_GITHUB_REPO=chenfengyimei/AIQB
AIQB_UPDATE_GITHUB_TOKEN=
AIQB_UPDATE_GITEE_REPO=chenfengloveyuri/aiqb
AIQB_UPDATE_GITEE_TOKEN=

# 官方仓库默认使用程序内置的发布公钥，无需设置。自建发行版可指定自己的 Ed25519 公钥文件。
# 这里只能配置公钥；发布私钥不得上传到服务器或写入环境变量。
AIQB_UPDATE_PUBLIC_KEY_FILE=

# 可选：在线更新重载后的本机健康检查地址，只允许 localhost/127.0.0.1/::1。
AIQB_UPDATE_HEALTH_URL=http://127.0.0.1:3000/health/live

# 可选：在线更新历史备份（代码+数据库+全量数据 tar）保留份数，默认 5。
AIQB_UPDATE_BACKUP_KEEP=5
